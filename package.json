{
  "name": "domlet",
  "type": "module",
  "scripts": {
    "dev": "esbuild main.ts --bundle --format=esm --outdir=public --sourcemap --watch --serve=3000 --servedir=public",
    "build": "esbuild main.ts --bundle --format=esm --outdir=public --minify --sourcemap=external",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.15.0"
}
